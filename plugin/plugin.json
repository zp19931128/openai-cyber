{
  "manifestVersion": 2,
  "name": "keyword-guard",
  "displayName": "请求关键词拦截",
  "publisher": "wason",
  "version": "0.2.1",
  "description": "每轮请求前匹配内置和补充 Cyber 与通用滥用关键词规则",
  "license": "Apache-2.0",
  "engines": {
    "codex-proxy-rs": ">=3.39.1, <=3.48.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "middleware": {
      "version": 6,
      "stages": [
        "request"
      ],
      "inputFormats": [
        "openai"
      ],
      "outputFormats": [
        "openai"
      ]
    },
    "management": {
      "version": 2
    }
  },
  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "type": "integer",
        "enum": [
          1
        ],
        "default": 1,
        "title": "配置格式版本"
      },
      "disabled_builtin_ids": {
        "type": "array",
        "title": "停用的内置规则 ID",
        "default": [],
        "maxItems": 1024,
        "items": {
          "type": "string",
          "maxLength": 128
        }
      },
      "extra_keywords": {
        "type": "array",
        "title": "补充拒绝短语",
        "default": [],
        "maxItems": 1024,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "extra_regexes": {
        "type": "array",
        "title": "补充拒绝正则",
        "default": [],
        "maxItems": 1024,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "custom_rules": {
        "type": "array",
        "title": "补充组合规则",
        "default": [],
        "maxItems": 1024,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "category",
            "description",
            "all_groups"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128
            },
            "category": {
              "type": "string",
              "maxLength": 64
            },
            "description": {
              "type": "string",
              "maxLength": 2048
            },
            "all_groups": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "max_span_chars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096,
              "default": 160
            },
            "word_boundaries": {
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "audit": {
        "type": "object",
        "title": "拦截审计",
        "additionalProperties": false,
        "default": {},
        "properties": {
          "capture_context": {
            "type": "boolean",
            "title": "保存脱敏后的请求上下文",
            "default": true
          }
        }
      }
    }
  },
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css"
  },
  "state": [
    {
      "namespace": "audit",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "timestamp_ms",
                "request_id",
                "client_key_id",
                "model",
                "transport",
                "rule_id",
                "category",
                "policy_version",
                "reason",
                "context",
                "context_truncated"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 128
                },
                "timestamp_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "request_id": {
                  "type": "string",
                  "maxLength": 128
                },
                "client_key_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256
                },
                "transport": {
                  "type": "string",
                  "maxLength": 64
                },
                "rule_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "category": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "policy_version": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "reason": {
                  "type": "string",
                  "maxLength": 256
                },
                "context": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4000
                },
                "context_truncated": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "maximumRecords": 1,
      "maximumBytes": 262144,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    }
  ]
}
